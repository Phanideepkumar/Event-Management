{
  "name": "eventdesk",
  "version": "1.0.0",
  "description": "Production-grade multi-tenant community event ticketing and RSVP platform built with MongoDB & Node.js",
  "main": "src/app.js",
  "bin": {
    "archive-events": "./bin/archive-events.js"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node src/server.js",
    "test": "jest --runInBand --detectOpenHandles",
    "test:watch": "jest --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "db:seed": "node bin/seed-data.js",
    "prepare": "husky || true"
  },
  "keywords": [
    "express",
    "mongodb",
    "mongoose",
    "passport",
    "ejs",
    "events",
    "ticketing"
  ],
  "author": "EventDesk Team",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "connect-flash": "^0.1.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-ejs-layouts": "^2.5.1",
    "express-session": "^1.18.1",
    "mongoose": "^8.10.1",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "eslint": "^9.21.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^15.4.3",
    "mongodb-memory-server": "^10.1.4",
    "supertest": "^7.0.0"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix"
    ]
  },
  "jest": {
    "testEnvironment": "node",
    "coveragePathIgnorePatterns": [
      "/node_modules/"
    ],
    "testTimeout": 120000
  }
}
