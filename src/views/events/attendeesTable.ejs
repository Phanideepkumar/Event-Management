<div class="attendees-table-container">
  <!-- Actions Bar (Hidden on Print) -->
  <div class="no-print" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; margin-bottom: 2rem;">
    <a href="/events/<%= event.id %>" class="btn btn-secondary btn-sm">← Back to Event Details</a>

    <div style="display: flex; gap: 0.75rem;">
      <button onclick="window.print()" class="btn btn-primary btn-sm">🖨️ Print / Save as PDF Table</button>
      <a href="/events/<%= event.id %>/export-attendees" class="btn btn-success btn-sm">⬇ Download CSV File</a>
    </div>
  </div>

  <!-- Event Header Sheet -->
  <div style="background: var(--bg-card); border: 1px solid var(--border-color); border-radius: var(--radius-lg); padding: 2rem; margin-bottom: 2rem;">
    <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 1rem; border-bottom: 1px solid var(--border-color); padding-bottom: 1rem; margin-bottom: 1rem;">
      <div>
        <span style="font-size: 0.85rem; color: var(--accent-cyan); text-transform: uppercase; font-weight: 700; letter-spacing: 0.05em;">Official Attendee Roster Sheet</span>
        <h1 style="font-size: 2rem; color: #fff; margin-top: 0.25rem;"><%= event.title %></h1>
        <p style="color: var(--text-muted); font-size: 0.95rem;">Host Organizer: <strong><%= event.organizer ? event.organizer.name : 'Unknown' %></strong></p>
      </div>

      <div style="text-align: right;">
        <span class="badge badge-published" style="font-size: 0.9rem; padding: 0.4rem 1rem;">Total Confirmed: <%= attendees.length %></span>
        <div style="font-size: 0.85rem; color: var(--text-dim); margin-top: 0.5rem;">Event Capacity: <%= event.totalCapacity %> Seats</div>
      </div>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; font-size: 0.9rem; color: var(--text-muted);">
      <div>
        <strong>Event Date:</strong> <%= new Date(event.eventDate).toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
      </div>
      <div>
        <strong>Generated On:</strong> <%= new Date().toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
      </div>
    </div>
  </div>

  <!-- Main Attendee Data Table -->
  <div style="background: var(--bg-card); border: 1px solid var(--border-color); border-radius: var(--radius-lg); padding: 2rem; overflow-x: auto;">
    <h3 style="font-size: 1.25rem; margin-bottom: 1.25rem; color: #fff;">Confirmed Registrations (<%= attendees.length %>)</h3>

    <% if (attendees && attendees.length > 0) { %>
      <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.92rem;">
        <thead>
          <tr style="border-bottom: 2px solid var(--border-color); color: var(--text-muted); font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.04em;">
            <th style="padding: 0.85rem 0.5rem; width: 40px;">#</th>
            <th style="padding: 0.85rem 0.5rem;">Ticket Code</th>
            <th style="padding: 0.85rem 0.5rem;">Full Name</th>
            <th style="padding: 0.85rem 0.5rem;">Reg No / Roll No</th>
            <th style="padding: 0.85rem 0.5rem;">Branch</th>
            <th style="padding: 0.85rem 0.5rem;">Section</th>
            <th style="padding: 0.85rem 0.5rem;">User Email</th>
            <th style="padding: 0.85rem 0.5rem;">Registered Date</th>
          </tr>
        </thead>
        <tbody>
          <% attendees.forEach(function(att, index) { %>
            <tr style="border-bottom: 1px solid rgba(255,255,255,0.06);">
              <td style="padding: 0.85rem 0.5rem; color: var(--text-dim);"><%= index + 1 %></td>
              <td style="padding: 0.85rem 0.5rem; font-family: monospace; font-weight: 700; color: var(--accent-cyan);"><%= att.ticketCode %></td>
              <td style="padding: 0.85rem 0.5rem; font-weight: 600; color: #fff;"><%= att.fullName || (att.user ? att.user.name : 'N/A') %></td>
              <td style="padding: 0.85rem 0.5rem; font-family: monospace; font-weight: 600; color: var(--accent-amber);"><%= att.regNo || 'N/A' %></td>
              <td style="padding: 0.85rem 0.5rem; color: var(--text-main);"><%= att.branch || 'N/A' %></td>
              <td style="padding: 0.85rem 0.5rem; color: var(--text-main);"><%= att.section ? `Sec ${att.section}` : 'N/A' %></td>
              <td style="padding: 0.85rem 0.5rem; color: var(--text-muted);"><%= att.user ? att.user.email : 'N/A' %></td>
              <td style="padding: 0.85rem 0.5rem; color: var(--text-dim);"><%= new Date(att.createdAt).toLocaleDateString() %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    <% } else { %>
      <div style="text-align: center; padding: 3rem 1rem; color: var(--text-muted);">
        <p>No confirmed registrations recorded for this event yet.</p>
      </div>
    <% } %>
  </div>
</div>

<style>
@media print {
  body {
    background: #fff !important;
    color: #000 !important;
  }
  .navbar, footer, .no-print, .flash-container {
    display: none !important;
  }
  .attendees-table-container {
    max-width: 100% !important;
    padding: 0 !important;
  }
  table {
    border: 1px solid #ccc !important;
  }
  th, td {
    color: #000 !important;
    border-bottom: 1px solid #ddd !important;
  }
}
</style>
