<div class="hero">
  <h1 class="hero-title">Discover & Host Community Tech Events</h1>
  <p class="hero-subtitle">Production-grade multi-tenant reservation engine. Instant RSVP with zero overbooking guarantee.</p>
</div>

<div class="events-section">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
    <h2>Upcoming Events</h2>
    <% if (currentUser && currentUser.role === 'organizer') { %>
      <a href="/events/new" class="btn btn-primary btn-sm">+ Host New Event</a>
    <% } %>
  </div>

  <% if (events && events.length > 0) { %>
    <div class="event-grid">
      <% events.forEach(function(event) { %>
        <%- include('../partials/eventCard', { event: event }) %>
      <% }); %>
    </div>
  <% } else { %>
    <div class="form-card" style="text-align: center;">
      <h3>No Events Scheduled</h3>
      <p style="color: var(--text-muted); margin-top: 0.5rem;">There are currently no upcoming published events.</p>
      <% if (currentUser && currentUser.role === 'organizer') { %>
        <a href="/events/new" class="btn btn-primary" style="margin-top: 1.25rem;">Create First Event</a>
      <% } %>
    </div>
  <% } %>
</div>
