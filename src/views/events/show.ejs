<div style="max-width: 900px; margin: 0 auto;">
  <div style="margin-bottom: 1.5rem;">
    <a href="/events" class="btn btn-secondary btn-sm">← Back to Events</a>
  </div>

  <div class="form-card" style="max-width: 100%; margin: 0 0 2rem 0; padding: 2.5rem;">
    <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 1rem; margin-bottom: 1rem;">
      <div>
        <h1 style="font-size: 2.2rem; line-height: 1.2; margin-bottom: 0.5rem;"><%= event.title %></h1>
        <p style="color: var(--text-muted); font-size: 1rem;">
          Organized by <strong><%= event.organizer ? event.organizer.name : 'Unknown' %></strong>
        </p>
      </div>
      <div>
        <% if (event.status === 'cancelled') { %>
          <span class="badge badge-cancelled" style="font-size: 0.9rem; padding: 0.4rem 1rem;">Cancelled</span>
        <% } else if (event.isSoldOut) { %>
          <span class="badge badge-soldout" style="font-size: 0.9rem; padding: 0.4rem 1rem;">Sold Out</span>
        <% } else { %>
          <span class="badge badge-published" style="font-size: 0.9rem; padding: 0.4rem 1rem;">Registration Open</span>
        <% } %>
      </div>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.25rem; background: rgba(0,0,0,0.25); border-radius: var(--radius-md); padding: 1.25rem; margin: 1.5rem 0;">
      <div>
        <span style="font-size: 0.85rem; color: var(--text-dim); display: block;">Date & Time</span>
        <strong style="color: #fff; font-size: 1.05rem;">
          <%= new Date(event.eventDate).toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
        </strong>
      </div>
      <div>
        <span style="font-size: 0.85rem; color: var(--text-dim); display: block;">Capacity Status</span>
        <strong style="color: #fff; font-size: 1.05rem;">
          <%= event.confirmedCount %> / <%= event.totalCapacity %> Reserved (<%= event.spotsLeft %> left)
        </strong>
      </div>
    </div>

    <!-- Active Ticket Card if User is Registered -->
    <% if (event.userRegistration) { %>
      <div class="ticket-card" style="flex-direction: column; align-items: stretch;">
        <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 1rem; border-bottom: 1px dashed rgba(255,255,255,0.15); padding-bottom: 1rem; margin-bottom: 1rem;">
          <div>
            <h3 style="color: #fff; font-size: 1.25rem; margin-bottom: 0.25rem;">✓ Ticket Confirmed!</h3>
            <p style="font-size: 0.9rem; color: var(--text-muted);">Present this ticket pass at the event entry.</p>
          </div>
          <div class="ticket-code"><%= event.userRegistration.ticketCode %></div>
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1rem; background: rgba(0,0,0,0.2); padding: 1rem; border-radius: var(--radius-md); margin-bottom: 1rem;">
          <div>
            <span style="font-size: 0.8rem; color: var(--text-dim); display: block;">Attendee Full Name</span>
            <strong style="color: #fff;"><%= event.userRegistration.fullName %></strong>
          </div>
          <div>
            <span style="font-size: 0.8rem; color: var(--text-dim); display: block;">Registration Number</span>
            <strong style="color: var(--accent-cyan); font-family: monospace;"><%= event.userRegistration.regNo %></strong>
          </div>
          <div>
            <span style="font-size: 0.8rem; color: var(--text-dim); display: block;">Branch</span>
            <strong style="color: #fff;"><%= event.userRegistration.branch %></strong>
          </div>
          <div>
            <span style="font-size: 0.8rem; color: var(--text-dim); display: block;">Section</span>
            <strong style="color: #fff;">Section <%= event.userRegistration.section %></strong>
          </div>
        </div>

        <div style="text-align: right;">
          <form action="/events/<%= event.id %>/cancel-rsvp" method="POST" style="display: inline;">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Are you sure you want to cancel your registration?')">Cancel Registration Pass</button>
          </form>
        </div>
      </div>
    <% } %>

    <div style="margin-bottom: 2rem;">
      <h3 style="font-size: 1.3rem; margin-bottom: 0.75rem; border-bottom: 1px solid var(--border-color); padding-bottom: 0.5rem;">Event Description</h3>
      <p style="color: var(--text-main); white-space: pre-line; line-height: 1.7;"><%= event.description || 'No detailed description provided.' %></p>
    </div>

    <!-- Registration Form Section if User is Not Yet Registered -->
    <% if (!event.userRegistration && event.status === 'published' && !event.isSoldOut) { %>
      <% if (currentUser) { %>
        <div style="background: rgba(15, 23, 42, 0.6); border: 1px solid var(--border-color); border-radius: var(--radius-lg); padding: 1.75rem; margin-top: 1.5rem;">
          <h3 style="font-size: 1.35rem; margin-bottom: 0.5rem; color: #fff;">📝 Register for Event</h3>
          <p style="color: var(--text-muted); font-size: 0.9rem; margin-bottom: 1.25rem;">Please fill out your details to complete registration and reserve your seat.</p>

          <form action="/events/<%= event.id %>/rsvp" method="POST">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; margin-bottom: 1.25rem;">
              <div class="form-group" style="margin-bottom: 0;">
                <label class="form-label" for="fullName">Full Name *</label>
                <input 
                  type="text" 
                  id="fullName" 
                  name="fullName" 
                  class="form-input" 
                  value="<%= currentUser.name %>" 
                  placeholder="e.g. John Doe"
                  required
                >
              </div>

              <div class="form-group" style="margin-bottom: 0;">
                <label class="form-label" for="regNo">Registration Number / Roll No *</label>
                <input 
                  type="text" 
                  id="regNo" 
                  name="regNo" 
                  class="form-input" 
                  placeholder="e.g. 21BCE1024" 
                  required
                >
              </div>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; margin-bottom: 1.5rem;">
              <div class="form-group" style="margin-bottom: 0;">
                <label class="form-label" for="branch">Branch *</label>
                <select id="branch" name="branch" class="form-select" required>
                  <option value="" disabled selected>Select Your Branch</option>
                  <option value="Computer Science & Engineering">Computer Science & Engineering (CSE)</option>
                  <option value="Information Technology">Information Technology (IT)</option>
                  <option value="Artificial Intelligence & Data Science">AI & Data Science (AI & DS)</option>
                  <option value="Electronics & Communication">Electronics & Communication (ECE)</option>
                  <option value="Electrical & Electronics">Electrical & Electronics (EEE)</option>
                  <option value="Mechanical Engineering">Mechanical Engineering (MECH)</option>
                  <option value="Civil Engineering">Civil Engineering (CIVIL)</option>
                </select>
              </div>

              <div class="form-group" style="margin-bottom: 0;">
                <label class="form-label" for="section">Section *</label>
                <select id="section" name="section" class="form-select" required>
                  <option value="" disabled selected>Select Section</option>
                  <option value="A">Section A</option>
                  <option value="B">Section B</option>
                  <option value="C">Section C</option>
                  <option value="D">Section D</option>
                  <option value="E">Section E</option>
                </select>
              </div>
            </div>

            <button type="submit" class="btn btn-success" style="width: 100%; font-size: 1.05rem; padding: 0.85rem;">Submit Registration & Reserve Ticket</button>
          </form>
        </div>
      <% } else { %>
        <div style="text-align: center; background: rgba(255,255,255,0.03); border: 1px dashed var(--border-color); border-radius: var(--radius-lg); padding: 2rem; margin-top: 1.5rem;">
          <p style="color: var(--text-muted); margin-bottom: 1rem;">Sign in to your account to fill out the registration form and reserve your ticket.</p>
          <a href="/auth/login" class="btn btn-primary">Sign In to Register</a>
        </div>
      <% } %>
    <% } else if (!event.userRegistration && event.isSoldOut) { %>
      <div style="text-align: center; margin-top: 1.5rem;">
        <button class="btn btn-secondary" disabled style="width: 100%; padding: 0.85rem;">Event Sold Out (No Seats Available)</button>
      </div>
    <% } %>

    <!-- Organizer Owner Actions -->
    <% if (currentUser && currentUser.id === event.organizerId) { %>
      <div style="display: flex; gap: 1rem; align-items: center; flex-wrap: wrap; margin-top: 2rem; padding-top: 1.25rem; border-top: 1px solid var(--border-color);">
        <span style="font-weight: 600; color: var(--text-muted);">Organizer Tools:</span>
        <div style="margin-left: auto; display: flex; gap: 0.75rem; flex-wrap: wrap;">
          <a href="/events/<%= event.id %>/attendees-table" class="btn btn-secondary btn-sm">📋 View & Print Attendee Table</a>
          <a href="/events/<%= event.id %>/export-attendees" class="btn btn-success btn-sm">⬇ Export CSV Stream</a>
          <a href="/events/<%= event.id %>/edit" class="btn btn-primary btn-sm">Edit Event</a>
          <form action="/events/<%= event.id %>/delete" method="POST" style="display: inline;">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Are you sure you want to cancel this event?')">Cancel Event</button>
          </form>
        </div>
      </div>
    <% } %>
  </div>

  <!-- Attendee List for Organizer Owner -->
  <% if (currentUser && currentUser.id === event.organizerId) { %>
    <div class="form-card" style="max-width: 100%; padding: 2rem;">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem;">
        <h3>Registered Attendees (<%= event.registrations ? event.registrations.length : 0 %>)</h3>
        <a href="/events/<%= event.id %>/export-attendees" class="btn btn-secondary btn-sm">⬇ Download CSV Stream</a>
      </div>

      <% if (event.registrations && event.registrations.length > 0) { %>
        <table style="width: 100%; border-collapse: collapse; text-align: left;">
          <thead>
            <tr style="border-bottom: 1px solid var(--border-color); color: var(--text-muted); font-size: 0.85rem;">
              <th style="padding: 0.75rem 0.5rem;">Ticket Code</th>
              <th style="padding: 0.75rem 0.5rem;">Full Name</th>
              <th style="padding: 0.75rem 0.5rem;">Reg No</th>
              <th style="padding: 0.75rem 0.5rem;">Branch</th>
              <th style="padding: 0.75rem 0.5rem;">Section</th>
              <th style="padding: 0.75rem 0.5rem;">Email</th>
              <th style="padding: 0.75rem 0.5rem;">Registered At</th>
            </tr>
          </thead>
          <tbody>
            <% event.registrations.forEach(function(reg) { %>
              <tr style="border-bottom: 1px solid rgba(255,255,255,0.05); font-size: 0.9rem;">
                <td style="padding: 0.75rem 0.5rem; font-family: monospace; color: var(--accent-cyan);"><%= reg.ticketCode %></td>
                <td style="padding: 0.75rem 0.5rem; font-weight: 600;"><%= reg.fullName || (reg.user ? reg.user.name : 'N/A') %></td>
                <td style="padding: 0.75rem 0.5rem; font-family: monospace; color: var(--accent-amber);"><%= reg.regNo || 'N/A' %></td>
                <td style="padding: 0.75rem 0.5rem;"><%= reg.branch || 'N/A' %></td>
                <td style="padding: 0.75rem 0.5rem;"><%= reg.section || 'N/A' %></td>
                <td style="padding: 0.75rem 0.5rem; color: var(--text-muted);"><%= reg.user ? reg.user.email : 'N/A' %></td>
                <td style="padding: 0.75rem 0.5rem; color: var(--text-dim);"><%= new Date(reg.createdAt).toLocaleDateString() %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      <% } else { %>
        <p style="color: var(--text-muted);">No confirmed registrations yet.</p>
      <% } %>
    </div>
  <% } %>
</div>
