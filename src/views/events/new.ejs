<div class="form-card">
  <h2 class="form-title">Publish New Event</h2>

  <% if (errors && errors.length > 0) { %>
    <div class="alert alert-error">
      <div>
        <% errors.forEach(function(err) { %>
          <div>• <%= err %></div>
        <% }); %>
      </div>
    </div>
  <% } %>

  <form action="/events" method="POST">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <div class="form-group">
      <label class="form-label" for="title">Event Title *</label>
      <input 
        type="text" 
        id="title" 
        name="title" 
        class="form-input" 
        placeholder="e.g. Node.js & Cloud Native Architecture" 
        value="<%= values.title || '' %>" 
        required
      >
    </div>

    <div class="form-group">
      <label class="form-label" for="description">Event Description</label>
      <textarea 
        id="description" 
        name="description" 
        class="form-textarea" 
        placeholder="Provide key topics, schedule, and guest speakers..."
      ><%= values.description || '' %></textarea>
    </div>

    <div class="form-group">
      <label class="form-label" for="eventDate">Event Date & Time (Future) *</label>
      <input 
        type="datetime-local" 
        id="eventDate" 
        name="eventDate" 
        class="form-input" 
        value="<%= values.eventDate || '' %>" 
        required
      >
    </div>

    <div class="form-group">
      <label class="form-label" for="totalCapacity">Total Capacity (Min: 1) *</label>
      <input 
        type="number" 
        id="totalCapacity" 
        name="totalCapacity" 
        class="form-input" 
        min="1" 
        placeholder="100" 
        value="<%= values.totalCapacity || '' %>" 
        required
      >
    </div>

    <div style="display: flex; gap: 1rem; margin-top: 2rem;">
      <button type="submit" class="btn btn-primary" style="flex: 1;">Publish Event</button>
      <a href="/events" class="btn btn-secondary">Cancel</a>
    </div>
  </form>
</div>
