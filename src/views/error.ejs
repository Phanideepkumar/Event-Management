<div class="form-card" style="text-align: center; max-width: 600px;">
  <div style="font-size: 3.5rem; margin-bottom: 0.5rem; color: var(--accent-rose); font-weight: 800;">
    <%= status || 500 %>
  </div>
  <h2 style="margin-bottom: 1rem;"><%= title || 'An Unexpected Error Occurred' %></h2>
  <p style="color: var(--text-muted); margin-bottom: 2rem;"><%= message || 'Something went wrong while processing your request.' %></p>

  <% if (error && error.stack) { %>
    <pre style="text-align: left; background: rgba(0,0,0,0.5); padding: 1rem; border-radius: var(--radius-md); font-size: 0.8rem; overflow-x: auto; color: #f87171; margin-bottom: 2rem;"><%= error.stack %></pre>
  <% } %>

  <a href="/events" class="btn btn-primary">Return to Homepage</a>
</div>
