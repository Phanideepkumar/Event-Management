<div class="form-card">
  <h2 class="form-title">Welcome Back to EventDesk</h2>

  <% if (errors && errors.length > 0) { %>
    <div class="alert alert-error">
      <div>
        <% errors.forEach(function(err) { %>
          <div>• <%= err %></div>
        <% }); %>
      </div>
    </div>
  <% } %>

  <form action="/auth/login" method="POST">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <div class="form-group">
      <label class="form-label" for="email">Email Address</label>
      <input 
        type="email" 
        id="email" 
        name="email" 
        class="form-input" 
        placeholder="alex@example.com" 
        required
      >
    </div>

    <div class="form-group">
      <label class="form-label" for="password">Password</label>
      <input 
        type="password" 
        id="password" 
        name="password" 
        class="form-input" 
        placeholder="••••••••" 
        required
      >
    </div>

    <button type="submit" class="btn btn-primary" style="width: 100%; margin-top: 1.5rem; padding: 0.75rem;">Sign In</button>
  </form>

  <p style="text-align: center; margin-top: 1.5rem; color: var(--text-muted); font-size: 0.9rem;">
    Don't have an account yet? <a href="/auth/register">Create Account</a>
  </p>
</div>
